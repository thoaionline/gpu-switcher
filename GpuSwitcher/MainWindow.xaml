<Window x:Class="GpuSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPU Switcher" Icon="Assets/GpuSwitcher.ico" Width="1250" Height="790" MinWidth="960" MinHeight="620"
        Background="#0B1120" Foreground="#ECF3FF" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#151E30"/>
        <SolidColorBrush x:Key="Border" Color="#26354B"/>
        <SolidColorBrush x:Key="Muted" Color="#98A8BF"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#23354F"/>
            <Setter Property="Foreground" Value="#ECF3FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#ECF3FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleShell" Background="#1C2B40" BorderBrush="#354763"
                                BorderThickness="1" CornerRadius="8" Padding="11,9">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Track" Width="36" Height="20" Background="#52657A"
                                        CornerRadius="10" Margin="0,0,10,0">
                                    <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#F0F6FF"
                                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#26B6AE"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleShell" Property="BorderBrush" Value="#63D7D1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleShell" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111A2A"/>
            <Setter Property="Foreground" Value="#ECF3FF"/>
            <Setter Property="BorderBrush" Value="#354763"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="#ECF3FF"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1C2B40"/>
            <Setter Property="Foreground" Value="#ECF3FF"/>
            <Setter Property="BorderBrush" Value="#354763"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <ContentPresenter Margin="11,0,30,0" VerticalAlignment="Center"
                                                      HorizontalAlignment="Left" IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#C9D9E9" StrokeThickness="1.5"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#1C2B40" BorderBrush="#49617B" BorderThickness="1"
                                        CornerRadius="6" Padding="4" MinWidth="{Binding ActualWidth, ElementName=FilterBox}">
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#63D7D1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1C2B40"/>
            <Setter Property="Foreground" Value="#ECF3FF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBackground" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="#31516A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="#176E73"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ECF3FF"/>
            <Setter Property="BorderBrush" Value="#26354B"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,7"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#20314A"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#26405F"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#1A2940"/>
            <Setter Property="Foreground" Value="#AFC1D8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="GPU SWITCHER" Foreground="#63D7D1" FontSize="12" FontWeight="Bold" Margin="0,0,0,7"/>
                <TextBlock Text="Move apps to high performance" FontSize="27" FontWeight="Bold"/>
                <TextBlock Text="Review running desktop apps, then save their Windows graphics preference in one action."
                           Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="20,0,0,0">
                <Button Content="↻  Refresh now" Click="Refresh_Click" HorizontalAlignment="Right" Margin="0,0,0,8"/>
                <ToggleButton x:Name="AutoSwitchToggle" Content="Auto switch every minute" IsEnabled="False"
                              Checked="AutoSwitchToggle_Checked" Unchecked="AutoSwitchToggle_Unchecked"
                              HorizontalAlignment="Right" Margin="0,0,0,8"
                              AutomationProperties.Name="Automatically refresh and set eligible apps to High performance every minute"
                              ToolTip="While this window is open, scan and set newly detected eligible apps to High performance every 60 seconds."/>
                <ToggleButton x:Name="LaunchAtStartupToggle" Content="Launch at startup (minimized)"
                              Checked="LaunchAtStartupToggle_Changed" Unchecked="LaunchAtStartupToggle_Changed"
                              HorizontalAlignment="Right"
                              AutomationProperties.Name="Launch GPU Switcher minimized when signing in to Windows"
                              ToolTip="Start GPU Switcher minimized when you sign in to this Windows account."/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="HIGH PERFORMANCE GPU" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="PreferredGpuText" Text="Detecting…" FontSize="17" FontWeight="SemiBold" Margin="0,7,16,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="OTHER ADAPTERS" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="OtherGpusText" Text="Detecting…" FontSize="15" Margin="0,8,16,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="RUNNING APPS" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="CountText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Width="310" HorizontalAlignment="Left" TextChanged="Filter_Changed"
                     ToolTip="Search app names and executable paths"/>
            <ComboBox x:Name="FilterBox" Grid.Column="1" Width="170" SelectedIndex="1" SelectionChanged="Filter_Changed" Margin="10,0">
                <ComboBoxItem Content="All processes"/><ComboBoxItem Content="Using other GPU"/><ComboBoxItem Content="Eligible apps"/>
            </ComboBox>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Select eligible" Click="SelectEligible_Click" Margin="0,0,8,0"/>
                <Button Content="Clear" Click="Clear_Click"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <ListView x:Name="ProcessList" Background="Transparent" BorderThickness="0" Foreground="#ECF3FF"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding Eligible}" Margin="10,0,0,0" VerticalAlignment="Center"/></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="APPLICATION" Width="190" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="PID" Width="105" DisplayMemberBinding="{Binding Pids}"/>
                        <GridViewColumn Header="GPU OBSERVED" Width="330" DisplayMemberBinding="{Binding Gpu}"/>
                        <GridViewColumn Header="WINDOWS PREFERENCE" Width="150" DisplayMemberBinding="{Binding Preference}"/>
                        <GridViewColumn Header="STATUS" Width="170" DisplayMemberBinding="{Binding Note}"/>
                    </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="ToolTip" Value="{Binding Path}"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Border>
        <Grid Grid.Row="4" Margin="0,15,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Starting…" Foreground="#9DC4D3" FontSize="13"/>
                <TextBlock Text="Preferences take effect when apps are restarted. GPU activity is a brief sample, not a guarantee."
                           Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="UndoButton" Content="Undo last change" Click="Undo_Click" Margin="0,0,8,0"/>
                <Button x:Name="ApplySelectedButton" Content="Set selected" Click="ApplySelected_Click" Margin="0,0,8,0"/>
                <Button x:Name="ApplyAllButton" Content="Set all eligible to High performance" Click="ApplyAll_Click"
                        Background="#26B6AE" Foreground="#06131D"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
